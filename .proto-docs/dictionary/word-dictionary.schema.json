{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/proto-docs/word-dictionary.schema.json",
  "title": "Proto Docs Word Dictionary",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/dictionaryEntry"
  },
  "$defs": {
    "dictionaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "scope",
        "canonical_description",
        "aliases",
        "forbidden_aliases",
        "allowed_contexts",
        "approved_examples",
        "status",
        "version",
        "owner",
        "last_reviewed_at",
        "visibility"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "^([A-Za-z][A-Za-z0-9]*\\.)?[a-z][a-z0-9_]*$"
        },
        "canonical_description": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "forbidden_aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "allowed_contexts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "approved_examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "const": "approved"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "last_reviewed_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "visibility": {
          "enum": ["public", "internal", "restricted"]
        }
      }
    }
  }
}
